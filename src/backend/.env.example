# =============================================================================
# S1 Semiconductor AI — Backend Environment Variables
# =============================================================================
# Copy this file to src/backend/.env and fill in your values.
# NEVER commit the real .env file — it is listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Full PostgreSQL DSN.  Format:
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# For async (asyncpg) use:
#   postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/s1_wafer_db

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info           # debug | info | warning | error

# ---------------------------------------------------------------------------
# Model paths (relative to the repo root, or absolute)
# ---------------------------------------------------------------------------
SECOM_MODEL_PATH=src/backend/ml/secom_classifier_model.pkl
WAFERMAP_MODEL_PATH=src/backend/ml/wafermap_dl_model.pth

# ---------------------------------------------------------------------------
# IBM watsonx.ai  (optional — only if LLM explanation feature is used)
# ---------------------------------------------------------------------------
# Instructions to get a free API key:
# 1. Sign up for a free IBM Cloud account at cloud.ibm.com
# 2. Provision a watsonx.ai or Watson Machine Learning instance
# 3. Create an API Key in Manage > Access (IAM) > API Keys
# 4. Find your Project ID in the watsonx.ai project settings
WATSONX_API_KEY=your_ibm_api_key_here
WATSONX_PROJECT_ID=your_ibm_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29
WATSONX_MODEL_ID=meta-llama/llama-3-70b-instruct

